---
# Swift API notes for Darling's AppKit: the Swift names and importer behaviour the AppKit overlay
# (and applications written against the public AppKit API) rely on. This file covers the declarations the
# overlay uses; the rest of the public AppKit surface is added as it is declared in these headers.
Name: AppKit

# Types that Swift nests in the class they belong to.
Typedefs:
- Name: NSFontWeight
  SwiftName: NSFont.Weight
- Name: NSStackViewVisibilityPriority
  SwiftName: NSStackView.VisibilityPriority
- Name: NSToolbarItemVisibilityPriority
