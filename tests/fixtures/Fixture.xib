<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright (C) 2026 Lubos Dolezel. Hand-written test input for ibtool (MC13). -->
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="25408" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="25408"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="FixtureOwner">
            <connections>
                <outlet property="window" destination="w1" id="c1"/>
                <outlet property="label" destination="t1" id="c2"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <window title="Fixture Window" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" releasedWhenClosed="NO" animationBehavior="default" id="w1">
            <windowStyleMask key="styleMask" titled="YES" closable="YES" miniaturizable="YES" resizable="YES"/>
            <windowPositionMask key="initialPositionMask" leftStrut="YES" rightStrut="YES" topStrut="YES" bottomStrut="YES"/>
            <rect key="contentRect" x="200" y="200" width="320" height="160"/>
            <rect key="screenRect" x="0.0" y="0.0" width="1440" height="900"/>
            <view key="contentView" id="v1">
                <rect key="frame" x="0.0" y="0.0" width="320" height="160"/>
                <autoresizingMask key="autoresizingMask"/>
                <subviews>
                    <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="t1">
                        <rect key="frame" x="18" y="112" width="284" height="16"/>
                        <textFieldCell key="cell" lineBreakMode="clipping" title="Hello from a fixture" id="tc1">
                            <font key="font" metaFont="system"/>
                            <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                    </textField>
                    <button verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="b1">
                        <rect key="frame" x="13" y="13" width="100" height="32"/>
                        <buttonCell key="cell" type="push" title="Press" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="bc1">
                            <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                            <font key="font" metaFont="system"/>
                        </buttonCell>
                        <connections>
                            <action selector="press:" target="-2" id="c3"/>
                        </connections>
                    </button>
                    <customView translatesAutoresizingMaskIntoConstraints="NO" id="cv1" customClass="FixtureMissingView">
                        <rect key="frame" x="200" y="20" width="100" height="60"/>
                        <constraints>
                            <constraint firstAttribute="width" constant="100" id="k8"/>
                            <constraint firstAttribute="height" constant="60" id="k9"/>
                        </constraints>
                    </customView>
                </subviews>
                <constraints>
                    <constraint firstItem="t1" firstAttribute="leading" secondItem="v1" secondAttribute="leading" constant="20" id="k1"/>
                    <constraint firstItem="t1" firstAttribute="top" secondItem="v1" secondAttribute="top" constant="32" id="k2"/>
                    <constraint firstAttribute="trailing" secondItem="t1" secondAttribute="trailing" constant="20" id="k3"/>
                    <constraint firstItem="b1" firstAttribute="leading" secondItem="v1" secondAttribute="leading" constant="20" id="k4"/>
                    <constraint firstAttribute="bottom" secondItem="b1" secondAttribute="bottom" constant="20" id="k5"/>
                    <constraint firstAttribute="trailing" secondItem="cv1" secondAttribute="trailing" constant="20" id="k6"/>
                    <constraint firstAttribute="bottom" secondItem="cv1" secondAttribute="bottom" constant="20" id="k7"/>
                </constraints>
            </view>
        </window>
        <menu title="FixtureMenu" id="m1">
            <items>
                <menuItem title="First" keyEquivalent="f" id="mi1"/>
                <menuItem isSeparatorItem="YES" id="mi2"/>
                <menuItem title="Second" state="on" tag="7" id="mi3"/>
            </items>
        </menu>
    </objects>
</document>
