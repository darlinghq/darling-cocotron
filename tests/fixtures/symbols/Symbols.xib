<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright (C) 2026 Lubos Dolezel. Hand-written test input for ibtool: images that name system symbols. -->
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="25408" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="25408"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="NSObject"/>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView id="v1">
            <rect key="frame" x="0.0" y="0.0" width="200" height="100"/>
            <autoresizingMask key="autoresizingMask"/>
            <subviews>
                <imageView identifier="plain" id="i1">
                    <rect key="frame" x="10" y="10" width="32" height="32"/>
                    <autoresizingMask key="autoresizingMask"/>
                    <imageCell key="cell" refusesFirstResponder="YES" alignment="left" imageScaling="proportionallyDown" image="folder" catalog="system" id="ic1"/>
                </imageView>
                <button identifier="configured" id="b1">
                    <rect key="frame" x="60" y="10" width="32" height="32"/>
                    <autoresizingMask key="autoresizingMask"/>
                    <buttonCell key="cell" type="bevel" bezelStyle="regularSquare" imagePosition="only" alignment="center" imageScaling="proportionallyDown" inset="2" id="bc1">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                        <imageReference key="image" image="eject.fill" catalog="system" symbolScale="small"/>
                    </buttonCell>
                </button>
                <imageView identifier="named" id="i2">
                    <rect key="frame" x="110" y="10" width="32" height="32"/>
                    <autoresizingMask key="autoresizingMask"/>
                    <imageCell key="cell" refusesFirstResponder="YES" alignment="left" imageScaling="proportionallyDown" image="NSFolder" id="ic2"/>
                </imageView>
            </subviews>
        </customView>
    </objects>
    <resources>
        <image name="folder" catalog="system" width="18" height="14"/>
        <image name="NSFolder" width="32" height="32"/>
    </resources>
</document>
